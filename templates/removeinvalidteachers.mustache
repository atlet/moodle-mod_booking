{{!
    @template mod_booking/removeinvalidteachers

    Template for displaying invalid teachers and removal options.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * has_invalid_teachers - boolean
    * invalid_teachers - array of teacher objects
    * remove_url - URL for removing teachers only
    * remove_with_options_url - URL for removing teachers and options
    * cancel_url - URL to cancel and go back

    Example context (json):
    {
        "cmid": 123,
        "has_invalid_teachers": true,
        "invalid_teachers": [
            {
                "userid": 456,
                "fullname": "John Doe",
                "options": [
                    {"optionid": 789, "optionname": "Option 1", "optionurl": "/mod/booking/view.php?id=123"}
                ]
            }
        ],
        "remove_url": "/mod/booking/view.php?id=123&action=remove",
        "remove_with_options_url": "/mod/booking/view.php?id=123&action=removewithoptions",
        "cancel_url": "/mod/booking/view.php?id=123"
    }
}}
<div class="mod-booking-remove-invalid-teachers">
    <div class="alert alert-info">
        {{#str}} removeinvalidteachers_desc, mod_booking {{/str}}
    </div>

    {{#has_invalid_teachers}}
        <p class="font-weight-bold">{{#str}} invalidteachersfound, mod_booking {{/str}}</p>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>{{#str}} teacher, mod_booking {{/str}}</th>
                    <th>{{#str}} bookingoptions, mod_booking {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#invalid_teachers}}
                <tr>
                    <td>{{{fullname}}}</td>
                    <td>
                        <ul class="list-unstyled mb-0">
                            {{#options}}
                            <li><a href="{{{optionurl}}}">{{{optionname}}}</a></li>
                            {{/options}}
                        </ul>
                    </td>
                </tr>
                {{/invalid_teachers}}
            </tbody>
        </table>

        <div class="mt-3">
            <form method="post" action="{{{remove_url}}}" style="display: inline;">
                <button type="submit" class="btn btn-warning mr-2">
                    {{#str}} removeteachersonly, mod_booking {{/str}}
                </button>
            </form>
            <form method="post" action="{{{remove_with_options_url}}}" style="display: inline;">
                <button type="submit" class="btn btn-danger mr-2">
                    {{#str}} removeteachersandoptions, mod_booking {{/str}}
                </button>
            </form>
            <a href="{{{cancel_url}}}" class="btn btn-secondary">
                {{#str}} cancel {{/str}}
            </a>
        </div>
    {{/has_invalid_teachers}}

    {{^has_invalid_teachers}}
        <div class="alert alert-success">
            {{#str}} noinvalidteachers, mod_booking {{/str}}
        </div>
    {{/has_invalid_teachers}}
</div>
